# Configuración de SumarImpacto — Grupo A13
# Para crear el .env a partir de este archivo, con el secreto ya generado: npm run setup
# El .env real nunca se sube al repositorio (está en .gitignore).

# Puerto del servidor (opcional; si no se define, se usa 3000).
PORT=3000

# Base de datos. Por defecto, MongoDB local (MongoDB Community Server): funciona sin pedir nada.
# "sumarimpacto" es el nombre de la base: MongoDB la crea con la primera escritura.
MONGO_URI=mongodb://127.0.0.1:27017/sumarimpacto

# Alternativa para el equipo: MongoDB Atlas (base compartida). Pedir acceso al proyecto en Atlas,
# crear un usuario de base propio y reemplazar la línea de arriba por la cadena de conexión:
# MONGO_URI=mongodb://USUARIO:PASSWORD@NODO_00:27017,NODO_01:27017,NODO_02:27017/sumarimpacto?tls=true&replicaSet=REPLICA_SET&authSource=admin

# Base de los tests automáticos: siempre local y separada (nunca la de Atlas).
MONGO_URI_TEST=mongodb://127.0.0.1:27017/sumarimpacto_test

# Clave secreta que firma la cookie de sesión. Obligatoria: sin ella la app no arranca.
# Cada entorno usa una propia, al azar. npm run setup la completa sola; a mano se genera con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
