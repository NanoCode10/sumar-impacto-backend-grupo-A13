# Configuración de SumarImpacto — Grupo A13

PORT=3000

# MongoDB Atlas
# Solicitar las credenciales al responsable del proyecto.
# Nunca subir el archivo .env real al repositorio.

MONGO_URI=mongodb://USUARIO:PASSWORD@NODO_00:27017,NODO_01:27017,NODO_02:27017/sumarimpacto?tls=true&replicaSet=REPLICA_SET&authSource=admin

# Base de pruebas local (no utilizar la base compartida de Atlas)
MONGO_URI_TEST=mongodb://127.0.0.1:27017/sumarimpacto_test

# Clave secreta que firma la cookie de sesión. Obligatoria: sin ella la app no arranca.
# Cada entorno usa una propia, al azar. Para generarla:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
