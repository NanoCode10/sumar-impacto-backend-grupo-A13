# Copiar este archivo como .env (el archivo .env no se sube a Git).

# Puerto del servidor (opcional; si no se define, se usa 3000).
PORT=3000

# Cadena de conexión a MongoDB local (MongoDB Community Server).
# "sumarimpacto" es el nombre de la base: MongoDB la crea con la primera escritura.
MONGO_URI=mongodb://127.0.0.1:27017/sumarimpacto
