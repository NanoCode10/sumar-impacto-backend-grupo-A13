extends layout

block content
  .card
    h2 Gestión de campañas
    p La tabla se carga y se actualiza con fetch() contra la API, sin recargar la página.
    p Sólo una organización aprobada puede recibir campañas: si elegís otra, la API lo rechaza.

    form#camp-form
      h3#form-titulo Nueva campaña

      label(for="title") Título
      input#title(type="text", name="title", required, minlength="5", maxlength="120")

      label(for="description") Descripción
      textarea#description(name="description", required, rows="3")

      label(for="targetAmount") Monto objetivo
      input#targetAmount(type="number", name="targetAmount", required, min="0.01", step="0.01")

      label(for="organizationId") Organización
      //- Las opciones las completa public/js/campaigns.js con fetch a /api/organizations.
      select#organizationId(name="organizationId", required)
        option(value="") Cargando...

      label(for="status") Estado
      select#status(name="status")
        option(value="") (sin indicar)
        each status in statuses
          option(value=status)= status

      .acciones
        button(type="submit") Guardar
        button#btn-cancelar(type="button", hidden) Cancelar edición

    p#mensaje(role="status")

  h3.section-title Campañas
  table.tabla
    thead
      tr
        th Título
        th Organización
        th Monto objetivo
        th Estado
        th Acciones
    tbody#camp-tbody
      tr
        td(colspan="5") Cargando...

  p
    a(href="/") Volver al inicio

  script(src="/js/comun.js")
  script(src="/js/campaigns.js")
