extends layout

block content
  .card
    h2 Gestión de donantes
    p La tabla se carga y se actualiza con fetch() contra la API, sin recargar la página.

    //- El formulario sólo para quien puede gestionar donantes (superadmin, administrador).
    if permisos.donantes
      form#donor-form
        h3#form-titulo Nuevo donante
        //- id del donante que se está editando (vacío en el alta)
        input#id(type="hidden", name="id")

        label(for="name") Nombre
        input#name(type="text", name="name", required, minlength="3", maxlength="100")

        label(for="type") Tipo de donante
        select#type(name="type", required)
          option(value="") -- Elegí un tipo --
          each type in types
            option(value=type)= type

        //- Admite puntos y guiones: el servidor lo guarda normalizado y controla que no se repita.
        label(for="document") Documento (DNI o CUIT)
        input#document(type="text", name="document", required, minlength="7", maxlength="15")

        label(for="email") Email
        input#email(type="email", name="email", required)

        .checkbox-field
          input#isMember(type="checkbox", name="isMember", checked=false)
          label(for="isMember") ¿Es miembro?

        .acciones
          button(type="submit") Guardar
          button#btn-cancelar(type="button", hidden) Cancelar edición
    else
      p Tu rol puede consultar los donantes; no gestionarlos.

    p#mensaje(role="status")

  h3.section-title Donantes
  table.tabla
    thead
      tr
        th Nombre
        th Tipo
        th Documento
        th Email
        th Miembro
        th Estado
        th Acciones
    tbody#donor-tbody
      tr
        td(colspan="7") Cargando...

  p
    a(href="/") Volver al inicio

  script(src=`/js/comun.js?v=${versionEstaticos}`)
  script(src=`/js/donors.js?v=${versionEstaticos}`)
