extends layout

block content
  .card
    h2 Organización: #{organization.name}
    .field
      .field-label Nombre
      .field-value= organization.name
    .field
      .field-label Tipo
      .field-value= organization.type
    .field
      .field-label Email
      .field-value= organization.email
    .field
      .field-label Estado
      .field-value
        span.badge= organization.status
