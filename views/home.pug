extends layout

block content
  .card
    h2 Bienvenido a SumarImpacto
    p Plataforma de gestión de campañas solidarias para organizaciones sociales.
    p
      a(href="/organizations") Gestionar organizaciones

  h3.section-title Organizaciones
  if organizations.length === 0
    p.empty Sin organizaciones registradas.
  else
    ul.resource-list
      each org in organizations
        li.resource-item
          a(href=`/organizations/${org.id}`)
            strong= org.name
          span.meta &nbsp;· #{org.type} ·&nbsp;
          span.badge= org.status

  h3.section-title Campañas
  if campaigns.length === 0
    p.empty Sin campañas registradas.
  else
    ul.resource-list
      each camp in campaigns
        li.resource-item
          a(href=`/campaigns/${camp.id}`)
            strong= camp.title
          span.meta &nbsp;· Org ##{camp.organizationId} ·&nbsp;
          span.badge= camp.status
